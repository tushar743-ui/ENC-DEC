# .gitignore
# Ignore node_modules
node_modules/
# Ignore build output
dist/
build/
# Ignore logs
logs/
*.log
# Ignore environment variables
.env
# Ignore IDE files
.vscode/
.idea/
# Ignore OS files
.DS_Store
Thumbs.db
# Ignore coverage reports
coverage/
# Ignore temporary files
tmp/
# Ignore lock files
package-lock.json
yarn.lock
# Ignore test results
test-results/
# Ignore generated files
*.generated.js
*.generated.ts
# Ignore compiled files
*.js
*.ts
# Ignore coverage reports
coverage/
# Ignore debug files
debug/
# Ignore local configuration files
config/local/
# Ignore backup files
*.bak
*.backup
# Ignore cache files
.cache/
# Ignore public assets
public/assets/
# Ignore documentation
docs/
# Ignore database files
*.db
# Ignore media files
